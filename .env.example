# ===== 对话模型 =====
CHAT_API_KEY=sk-your-chat-api-key
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-flash

# ===== 向量模型 =====
EMBEDDING_API_KEY=sk-your-embedding-api-key
EMBEDDING_BASE_URL=https://your-embedding-endpoint.example.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=200

# ===== PostgreSQL =====
DB_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/dbname

# ===== Qdrant 向量库 =====
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# ===== 腾讯云 COS =====
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key
COS_REGION=ap-shanghai
COS_BUCKET=your-bucket-1250000000
COS_UPLOAD_EXPIRES=600
COS_DOWNLOAD_EXPIRES=900

# ===== JWT =====
JWT_SECRET_KEY=change-me-to-a-random-32-bytes-secret
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# ===== 服务地址（API 端 / Agent 端，双进程）=====
# API_BASE_URL 需要能被模型服务访问，图片附件通过它回源
AGENT_BASE_URL=http://127.0.0.1:8001
API_BASE_URL=http://127.0.0.1:8000
AGENT_HTTP_MAX_CONNECTIONS=200
AGENT_HTTP_MAX_KEEPALIVE_CONNECTIONS=20

# ===== 存储 =====
DATA_ROOT=./.data
MAX_UPLOAD_BYTES=104857600
KNOWLEDGE_MAX_UPLOAD_BYTES=31457280

# ===== 教学资料库 =====
MATERIALS_DIR=./app/agent/resource/materials

# ===== Agent 可观测性（Langfuse）=====
LANGFUSE_ENABLED=true
LANGFUSE_SERVICE_NAME=network-agent
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
